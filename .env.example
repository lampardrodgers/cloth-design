PORT=8888
HOST=127.0.0.1
PUBLIC_APP_URL=http://127.0.0.1:8888
AUTH_SECRET=change-me-to-a-random-32-byte-secret
ADMIN_EMAILS=admin@clothdesign.local
# 是否开放自助注册。false = 登录页只剩登录，账号一律由管理员在 /admin 创建。
ALLOW_SELF_SIGNUP=true
# 开放自助注册时，新账号默认要等管理员在 /admin 开通；改成 false 则注册即用。
# 后台创建的账号不受这一项影响，建好就能直接登录。
SIGNUP_APPROVAL=true
# 「开发调试」座位（跳过登录、无限额度）。界面上已经没有入口，只剩 /api/debug/session 这个端点，
# 默认只在非生产环境可用。给某个账号免积分请改用后台「用户与用量」里的「无限」开关。
DEBUG_UNLIMITED=false
DATABASE_URL=file:./data/clothdesign.db
IMAGE_ASSET_DIR=./data/generated-images
IMAGE_ASSET_PUBLIC_PATH=/generated-images
VIDEO_ASSET_DIR=./data/generated-videos
VIDEO_ASSET_PUBLIC_PATH=/generated-videos
FFMPEG_BIN=ffmpeg
# 成片在服务器上固定保留 3 天（写死在 server/storage.mjs），服务进程每小时自动巡检清理；
# STORAGE_MAINTENANCE=false 可以关掉自动巡检（一般不用动）。WEBDAV_TIMEOUT_MS 是推送云盘的单次超时。
STORAGE_MAINTENANCE=true
WEBDAV_TIMEOUT_MS=30000
# 下面两个只给手动脚本 npm run cleanup:images 用（清没人引用的孤儿文件）
IMAGE_CLEANUP_MAX_AGE_DAYS=30
IMAGE_CLEANUP_DRY_RUN=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_IMAGE_MODEL=gpt-image-2
# 第二套图像接口；与 OPENAI_* 同时生效，用户可在账户页选择。
APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai/v1
APIMART_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TIMEOUT_MS=120000
IMAGE_DOWNLOAD_TIMEOUT_MS=120000
WORKFLOW_ASSET_DOWNLOAD_TIMEOUT_MS=120000
OPENAI_DEMO_MODE=false
PUBLIC_APP_MODE=production

# 非生产环境默认显示“∞ 开发调试”入口，设置为 false 可关闭。
DEBUG_UNLIMITED=true

# 短视频模块（MoneyPrinterTurbo 引擎，默认仅 admin 可用，见 docs/shortvideo-module.md）
# 引擎只监听本机回环地址；不配 URL 就是「引擎未接入」，模块照常显示但不能创建任务。
SHORTVIDEO_ENGINE_URL=
SHORTVIDEO_ENGINE_API_KEY=
SHORTVIDEO_ENGINE_TIMEOUT_MS=20000
SHORTVIDEO_ASSET_DIR=./data/shortvideo
SHORTVIDEO_POLL_INTERVAL_MS=3000
SHORTVIDEO_MAX_ACTIVE_PER_USER=2
SHORTVIDEO_RENDER_THREADS=2
# 指到引擎的 config.toml，后台「短视频接口」就能直接改素材库 Key / 字幕方案 / 并发；
# 引擎只在启动时读一次配置，所以再配一条重启命令，后台才有「重启引擎」按钮。
SHORTVIDEO_ENGINE_CONFIG=
SHORTVIDEO_ENGINE_RESTART_CMD=
# 文案 / 关键词用的 chat 接口。# 下面这些后台「短视频接口」里都能改，改完立刻生效（数据库覆盖 .env）。
SHORTVIDEO_LLM_PROVIDER=default|apimart 表示复用哪条图像线路的地址和共享 Key
# （图像 Key 不一定能聊天：Packy 的图像 Key 只有 gpt-image-2，所以一般指到 apimart）；也可以用 BASE_URL / API_KEY 单独指定。模型默认 gpt-4o-mini。
SHORTVIDEO_LLM_PROVIDER=default
SHORTVIDEO_LLM_BASE_URL=
SHORTVIDEO_LLM_API_KEY=
SHORTVIDEO_LLM_MODEL=gpt-4o-mini

# Optional production services for capabilities that are still marked as external blockers.
AI_VIDEO_API_URL=
AI_VIDEO_API_KEY=
AI_VIDEO_TIMEOUT_MS=120000
VIDEO_DOWNLOAD_TIMEOUT_MS=120000
SEGMENTATION_API_URL=
SEGMENTATION_API_KEY=
SEGMENTATION_TIMEOUT_MS=120000
BRAND_TRAINING_API_URL=
BRAND_TRAINING_API_KEY=
BRAND_TRAINING_TIMEOUT_MS=120000

# Payment demo mode auto-enables if merchant credentials are missing.
# Set PAYMENT_DEMO_MODE=false in production after configuring real merchant keys.
PAYMENT_DEMO_MODE=true
PAYMENT_REQUIRED_PROVIDERS=alipay,wechat
PAYMENT_REQUEST_TIMEOUT_MS=30000
# Only for automated smoke tests against NODE_ENV=production without real merchant keys.
ALLOW_PAYMENT_DEMO_API=false

# Alipay official merchant integration.
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY_PATH=./secrets/alipay-app-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=./secrets/alipay-public-key.pem
ALIPAY_NOTIFY_URL=https://your-domain.example/api/payments/alipay/notify
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# WeChat Pay API v3 Native integration.
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=./secrets/wechat-mch-private-key.pem
WECHAT_API_V3_KEY=
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_PATH=./secrets/wechatpay-public-key.pem
WECHAT_NOTIFY_URL=https://your-domain.example/api/payments/wechat/notify
